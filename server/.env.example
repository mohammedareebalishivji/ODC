# Copy to .env and fill in real values. .env is gitignored.

# --- Database -------------------------------------------------------------
# Supabase: Dashboard → Connect. Prefer the Session pooler; fall back to the
# Transaction pooler (port 6543) if your network is IPv4-only, because the
# direct host db.<ref>.supabase.co resolves over IPv6 only.
# Percent-encode any special characters in the password (, = %2C, @ = %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Client-side pool ceiling. Keep below the pooler's per-project budget.
DB_POOL_MAX=8

# Set to "disable" only for a local Postgres with no TLS.
# DATABASE_SSL=disable

# Overrides the bundled Supabase CA (server/certs/supabase-ca.crt).
# DATABASE_CA_PATH=/absolute/path/to/prod-ca-2021.crt

# --- Real-time (optional) --------------------------------------------------
# A single API instance is already fully real-time: it performs every write
# and pushes to its own SSE connections in-process. These are only needed to
# fan events across MULTIPLE instances behind a load balancer, where the
# instance handling a write is usually not the one holding the browser's
# stream.
#
# SUPABASE_SERVICE_KEY bypasses RLS completely. Server-side only — it must
# never reach the client bundle or any VITE_-prefixed variable.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key from Dashboard -> API keys>

# --- Payments (optional) ---------------------------------------------------
# Razorpay. Leave unset and the app behaves exactly as it did before payments
# were wired up: escrow holds open immediately as 'held' and no provider call
# is ever made. That is what local development and CI run as.
#
# Set them and holds instead open as 'pending_payment' and only become live
# when the provider confirms the venue's payment, so a worker can never be
# credited money that never arrived.
#
# Test keys are rzp_test_*; live keys are rzp_live_*. KEY_SECRET signs API
# calls and WEBHOOK_SECRET verifies callbacks -- they are different values,
# and the webhook one is set by you in Dashboard -> Settings -> Webhooks.
# RAZORPAY_KEY_ID=rzp_test_<id>
# RAZORPAY_KEY_SECRET=<api key secret>
# RAZORPAY_WEBHOOK_SECRET=<webhook signing secret>
#
# Point the provider's webhook at:
#   POST https://<your-host>/api/payments/webhook/razorpay
# subscribing to payment.captured, payment.failed, payout.processed,
# payout.failed and payout.reversed.

# --- App ------------------------------------------------------------------
PORT=4000
# NODE_ENV=production
# ODC_JWT_SECRET=<generated at first boot into server/data/jwt.secret if unset>
